NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Server only. Never prefix this key with NEXT_PUBLIC_.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional paid OpenAI configuration, used only with TRANSCRIPTION_PROVIDER=openai.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Server only: Supabase secret key (or legacy service_role key), for private username lookup.
# Email/password login still works without this key.
SUPABASE_SERVER_KEY=
